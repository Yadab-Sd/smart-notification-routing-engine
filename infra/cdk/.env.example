# Smart Notification Routing Engine - CDK Configuration Template
# Copy this file to .env and fill in your values

# Email address for sending notifications (REQUIRED)
# This email MUST be verified in Amazon SES before sending emails
# Example: SENDER_EMAIL=notifications@yourdomain.com
SENDER_EMAIL=your-email@example.com

# AWS Account ID (auto-detected from AWS CLI, no need to set)
# CDK_DEFAULT_ACCOUNT=123456789012

# AWS Region (auto-detected from AWS CLI, default: us-west-2)
# CDK_DEFAULT_REGION=us-west-2
