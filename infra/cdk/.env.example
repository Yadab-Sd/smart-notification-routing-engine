# Smart Notification Routing Engine - CDK Configuration Template
# Copy this file to .env and fill in your values: cp .env.example .env

# ===== REQUIRED =====

# Email address for sending notifications
# This email MUST be verified in Amazon SES before sending emails
# Verify: aws ses verify-email-identity --email-address your-email@example.com --region us-west-2
SENDER_EMAIL=your-email@example.com

# ===== OPTIONAL (auto-detected from AWS CLI) =====

# AWS Account ID and Region
# CDK automatically detects these from your AWS CLI credentials
# Only set if you need to override the defaults
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-west-2

# ===== OPTIONAL (for custom domain) =====

# Custom domain instead of CloudFront's *.cloudfront.net URL
# Leave blank to use default CloudFront URL
#
# Setup steps:
# 1. Register domain in Route 53 or use existing
# 2. Request ACM certificate (must be in us-east-1):
#    aws acm request-certificate --domain-name yourdomain.com --validation-method DNS --region us-east-1
# 3. Wait for ISSUED status (5-10 min):
#    aws acm describe-certificate --certificate-arn YOUR_ARN --region us-east-1 --query 'Certificate.Status'
# 4. Fill in values below
# 5. Deploy: pnpm exec cdk deploy SR-Frontend
# 6. Update DNS (see DEPLOYMENT.md)

CERTIFICATE_ARN=
CUSTOM_DOMAIN=

# Example:
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:952654481597:certificate/abc123-def456-7890
# CUSTOM_DOMAIN=intelligent-routing.com
